name: Pull website version (one-time)

# Downloads one build's source from Whop - the version shared from the dashboard,
# apbu_Xdfebsnj4ZgFq - into reference/web-version/ so it can be studied and
# merged into the live storefront. Needs the WHOP_API_KEY repo secret.
# Committing this file starts it (push trigger below). Delete it when the merge ships.

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - ".github/workflows/pull-web-version.yml"

permissions:
  contents: write

jobs:
  pull:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
        with:
          ref: main

      - uses: actions/setup-node@v5
        with:
          node-version: "22"

      - name: List the website app's web builds
        env:
          WHOP_API_KEY: ${{ secrets.WHOP_API_KEY }}
        run: |
          npx -y @whop/cli@0.25.0 apps builds list --app_id app_YYGHDJQJ2JnCku --platform web --first 50 --format json > /tmp/builds.json || true
          node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const j=JSON.parse(s);const rows=(j.data||j.builds||j.items||[]);console.log("builds found:",rows.length);for(const b of rows)console.log(" -",b.id,b.status||b.review_status||"",b.created_at||b.createdAt||"");}catch(e){console.log("raw:",s.slice(0,1500));}})' < /tmp/builds.json

      - name: Inspect the shared build (metadata + any archive or preview URL)
        env:
          WHOP_API_KEY: ${{ secrets.WHOP_API_KEY }}
        run: |
          curl -sS -H "Authorization: Bearer $WHOP_API_KEY" \
            "https://api.whop.com/api/v1/app_builds/apbu_Xdfebsnj4ZgFq" -o /tmp/build.json || true
          head -c 3000 /tmp/build.json; echo
          node -e 'try{const b=require("/tmp/build.json");const d=b.data||b;for(const k of ["hosted_url","preview_url","source_url","archive_url","web_url","url"]){if(d&&d[k])console.log(k+" = "+d[k]);}}catch(e){console.log("(no json)")}' || true

      - name: Pull that build's source into reference/web-version
        env:
          WHOP_API_KEY: ${{ secrets.WHOP_API_KEY }}
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git status --porcelain | sort > /tmp/before.txt || true
          npx -y @whop/cli@0.25.0 apps pull --app app_YYGHDJQJ2JnCku --build apbu_Xdfebsnj4ZgFq --dir reference/web-version --overwrite 2>&1 | tail -30 || true
          git status --porcelain | sort > /tmp/after.txt || true
          echo "--- new paths ---"
          comm -13 /tmp/before.txt /tmp/after.txt | head -80
          echo "--- files under reference/web-version ---"
          find reference/web-version -type f 2>/dev/null | head -80
          find reference/web-version -type f 2>/dev/null | wc -l
          comm -13 /tmp/before.txt /tmp/after.txt | sed -E 's/^.{3}//' | while read -r p; do
            case "$p" in
              reference/*) ;;
              *) if [ -f "$p" ]; then mkdir -p "reference/web-version-raw/$(dirname "$p")"; cp "$p" "reference/web-version-raw/$p"; fi ;;
            esac
          done || true
          echo "--- files under reference/ ---"
          find reference -type f | head -100
          find reference -type f | wc -l

      - name: Commit what was pulled
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add reference
          git commit -m "Pull website version apbu_Xdfebsnj4ZgFq (reference for the merge)" || echo "nothing new to commit"
          git push origin HEAD:main
